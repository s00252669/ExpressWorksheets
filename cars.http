@endpoint = http://localhost:3000/api/v1/cars
@apiKey = blahblah

### Get all cars
GET {{endpoint}} HTTP/1.1

###
# @name postACar
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "make" : "make2",
"model" : "model2"
  }

###
@newCar = {{postACar.response.body._id}}

### Get the car just created
GET {{endpoint}}/{{newCar}} HTTP/1.1
content-type: application/json

### Extra field → 201, colour stripped
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "make": "Ford", "model": "Focus", "colour": "red" }

### Missing model → 400
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "make": "Ford" }

### Empty string make → 400
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "make": "", "model": "Focus" }

### Too old year → 400
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "make": "Ford", "model": "Model T", "year": 1920 }

### String year → 400
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "make": "Ford", "model": "Focus", "year": "old" }

### No key → 401
POST {{endpoint}} HTTP/1.1
content-type: application/json

{ "make": "Ford", "model": "Focus" }

### Update just the model → 200
PUT {{endpoint}}/{{newCar}} HTTP/1.1
content-type: application/json

{ "model": "Fiesta" }

### Update with bad year → 400
PUT {{endpoint}}/{{newCar}} HTTP/1.1
content-type: application/json

{ "year": 1900 }

### Update with empty make → 400
PUT {{endpoint}}/{{newCar}} HTTP/1.1
content-type: application/json

{ "make": "" }

### Add a car → 201
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "make": "Renault", "model": "Megane", "year": 2010 }